<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Welcome Admin</title>
  </head>
  <body
    style="
      font-family: Arial, sans-serif;
      background-color: #f4f4f4;
      padding: 20px;
    "
  >
    <div style="background-color: #fff; padding: 30px; border-radius: 10px">
      <h2 style="color: #333">🎉 Welcome, Admin <%= name %>!</h2>
      <p>
        You have successfully created your admin account on
        <strong>Smart Pro</strong>.
      </p>
      <p>Your email: <strong><%= email %></strong></p>
      <p>You now have access to the admin dashboard to manage the platform.</p>
      <p>Stay awesome! 🚀</p>
    </div>
  </body>
</html>
