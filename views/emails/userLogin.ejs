<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Login Alert</title>
  </head>
  <body
    style="
      font-family: Arial, sans-serif;
      background-color: #f0fff0;
      padding: 20px;
    "
  >
    <div style="background-color: #fff; padding: 30px; border-radius: 10px">
      <h2 style="color: #52c41a">✅ Login Successful</h2>
      <p>Hello <strong><%= name %></strong>,</p>
      <p>
        You just logged in to your account on <strong>Smart Pro</strong>.
      </p>
      <p>If you didn't initiate this login, please change your password.</p>
      <p>Cheers! 🎯</p>
    </div>
  </body>
</html>
